{
  "name": "Netflix Dark",
  "dataColors": ["#E50914", "#3987E5", "#199E70", "#C98500", "#D55181", "#008300", "#9085E9", "#D95926"],
  "background": "#141414",
  "foreground": "#F5F5F5",
  "tableAccent": "#E50914",
  "good": "#46D369",
  "neutral": "#C98500",
  "bad": "#E50914",
  "maximum": "#FF6B72",
  "center": "#8F0A12",
  "minimum": "#2A0A0C",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#FFFFFF" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#FFFFFF" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#D4D4D4" },
    "callout": { "fontFace": "Segoe UI Bold", "fontSize": 28, "color": "#FFFFFF" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#141414" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#0B0B0B" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#1F1F1F" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#2A2A2A" } }, "radius": 10 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#FFFFFF" } }, "fontSize": 12 }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#A3A3A3" } }, "gridlineShow": false }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#A3A3A3" } },
                        "gridlineColor": { "solid": { "color": "#2A2A2A" } } }],
        "legend": [{ "labelColor": { "solid": { "color": "#D4D4D4" } } }],
        "dropShadow": [{ "show": false }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 28 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#A3A3A3" } } }]
      }
    },
    "slicer": {
      "*": {
        "items": [{ "fontColor": { "solid": { "color": "#F5F5F5" } },
                    "background": { "solid": { "color": "#1F1F1F" } } }],
        "header": [{ "fontColor": { "solid": { "color": "#E50914" } } }]
      }
    }
  }
}
